@model ProcesoFabricacion
@{
    ViewData["Title"] = "Editar proceso";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1">Editar proceso</h1>
                <p class="text-muted mb-0">Actualiza la información de @Model.Nombre.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden" />
                    <partial name="_Form" model="Model" />
                    <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    <a asp-action="Index" class="btn btn-link">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

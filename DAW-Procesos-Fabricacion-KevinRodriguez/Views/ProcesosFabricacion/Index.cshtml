@model IEnumerable<ProcesoFabricacion>
@{
    ViewData["Title"] = "Procesos de fabricación";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Procesos de fabricación</h1>
        <p class="text-muted mb-0">Administra las etapas disponibles para las órdenes de producción.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nuevo proceso</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                <th class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                @foreach (var proceso in Model)
                {
                    <tr>
                        <td class="fw-semibold">@proceso.Nombre</td>
                        <td>@proceso.Descripcion</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@proceso.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@proceso.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@proceso.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center py-5 text-muted">Todavía no hay procesos registrados.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

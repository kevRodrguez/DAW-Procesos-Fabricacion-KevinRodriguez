@model ProcesoFabricacion
@{
    ViewData["Title"] = "Eliminar proceso";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h1 class="h3 text-danger">¿Eliminar proceso?</h1>
                <p>Estás a punto de eliminar <strong>@Model.Nombre</strong>.</p>

                @if (Model.Ordenes.Any())
                {
                    <div class="alert alert-warning mb-4" role="alert">
                        Este proceso está asociado a @Model.Ordenes.Count orden(es) y no puede eliminarse.
                    </div>
                    <a asp-action="Index" class="btn btn-outline-secondary">Volver al listado</a>
                }
                else
                {
                    <p class="text-muted">Esta acción no se puede deshacer.</p>
                    <form asp-action="Delete" method="post" class="d-flex gap-2">
                        <input asp-for="Id" type="hidden" />
                        <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

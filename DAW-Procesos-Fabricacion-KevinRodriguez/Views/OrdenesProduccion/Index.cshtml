@model IEnumerable<OrdenProduccion>
@{
    ViewData["Title"] = "Órdenes de producción";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Órdenes de producción</h1>
        <p class="text-muted mb-0">Consulta y administra la producción de calzado.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Nueva orden</a>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th>@Html.DisplayNameFor(model => model.NumeroOrden)</th>
                <th>@Html.DisplayNameFor(model => model.ModeloCalzado)</th>
                <th>@Html.DisplayNameFor(model => model.Cantidad)</th>
                <th>Procesos</th>
                <th>@Html.DisplayNameFor(model => model.FechaEntregaEstimada)</th>
                <th class="text-end">Acciones</th>
            </tr>
            </thead>
            <tbody>
            @if (Model.Any())
            {
                @foreach (var orden in Model)
                {
                    <tr>
                        <td class="fw-semibold">@orden.NumeroOrden</td>
                        <td>@orden.ModeloCalzado</td>
                        <td>@orden.Cantidad</td>
                        <td><span class="badge text-bg-secondary">@orden.Procesos.Count</span></td>
                        <td>@orden.FechaEntregaEstimada.ToString("dd/MM/yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Details" asp-route-id="@orden.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                            <a asp-action="Edit" asp-route-id="@orden.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@orden.Id" class="btn btn-sm btn-outline-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">Todavía no hay órdenes registradas.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

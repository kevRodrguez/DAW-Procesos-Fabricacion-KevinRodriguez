@model OrdenProduccionFormViewModel
@{
    ViewData["Title"] = "Editar orden";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1">Editar orden</h1>
                <p class="text-muted mb-0">Actualiza @Model.NumeroOrden y sus procesos asociados.</p>
            </div>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Volver</a>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    <input asp-for="Id" type="hidden" />
                    <partial name="_Form" model="Model" />
                    @if (Model.ProcesosDisponibles.Any())
                    {
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    }
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model OrdenProduccionFormViewModel
@{
    ViewData["Title"] = "Nueva orden";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1">Nueva orden de producción</h1>
                <p class="text-muted mb-0">Registra la orden y las etapas necesarias para fabricarla.</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
        </div>
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <partial name="_Form" model="Model" />
                    @if (Model.ProcesosDisponibles.Any())
                    {
                        <button type="submit" class="btn btn-primary">Guardar orden</button>
                    }
                    <a asp-action="Index" class="btn btn-link">Cancelar</a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
